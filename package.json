{
  "name": "cc-daily-usage",
  "version": "0.1.1",
  "description": "Keep Claude Code spend predictable: daily/monthly budget tracking, a live statusline, and spend reports for pay-as-you-go teams.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagle/cc-daily-usage.git"
  },
  "bugs": {
    "url": "https://github.com/gagle/cc-daily-usage/issues"
  },
  "homepage": "https://github.com/gagle/cc-daily-usage#readme",
  "type": "module",
  "bin": {
    "cc-daily-usage": "./bin/cc-daily-usage.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "author": "Gabriel Llamas",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
