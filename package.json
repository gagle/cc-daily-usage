{
  "name": "cc-spend",
  "version": "0.1.0",
  "description": "Keep Claude Code spend predictable: a fast live statusline with daily/monthly budgets, fresh 5h/7d limits, and the cost of your next prompt.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagle/cc-spend.git"
  },
  "bugs": {
    "url": "https://github.com/gagle/cc-spend/issues"
  },
  "homepage": "https://github.com/gagle/cc-spend#readme",
  "type": "module",
  "bin": {
    "cc-spend": "bin/cc-spend.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/doc-drift.mjs check",
    "docs:drift": "node scripts/doc-drift.mjs drift"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "author": "Gabriel Llamas",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "usage",
    "budget",
    "cost",
    "prompt-cache"
  ]
}
